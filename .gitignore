.fixpoint/
# Pre-rename artifact directory. Kept ignored so a run's old logs -- which hold
# reviewed material and possibly secrets -- can never be swept into a commit.
logs/
/fixpoint
coverage.out
# Generated per-run by bench/run.sh; a committed candidate would shadow a real agent.
config/agents/bench-candidate.yaml
# `make bench-check` compiles every target to prove it still builds, and the
# output must never be committed: the bench reviews these directories with no
# excludes, so build artifacts would be handed to a reviewer as source. The
# pattern is per-target-directory rather than a bare name so a rename cannot
# quietly move a binary out from under it -- which is exactly how a 10 MB
# `linkd` got staged once.
bench/testdata/target-*/linkd
bench/testdata/target-*/target/
bench/testdata/target-*/**/*.class
bench/testdata/target-*/bin/
bench/testdata/target-*/obj/
bench/testdata/target-*/__pycache__/
bench/.run.lock
# GoReleaser's output. Built artifacts, never reviewed and never committed --
# and the archives contain a copy of the bundle, so a committed dist/ would put
# a second, stale copy of every prompt on the search path.
dist/
