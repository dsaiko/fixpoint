<Project Sdk="Microsoft.NET.Sdk">

  <!-- No PackageReference on purpose: `dotnet build` must work offline, and a
       reviewer must be able to read the whole target without a NuGet detour. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Linkd</RootNamespace>
    <AssemblyName>linkd</AssemblyName>
  </PropertyGroup>

</Project>
