#!/bin/sh
# fixpoint's own agent wrapper: what `-sandbox builtin` (or FIXPOINT_SANDBOX=builtin)
# runs every agent through. fixpoint calls it as
#
#   /bin/sh fixpoint-sandbox <dir> <ro|rw> -- <the agent's own argv...>
#
# where <dir> is the directory the invocation works in (the target, or for create
# and implement the snapshot or output directory) and <ro|rw> is whether the agent
# is declared can_edit. It is found only beside the fixpoint binary, never in a
# bundle a project or ~/.fixpoint can shadow (internal/config/sandbox.go).
#
# THE GOAL is to keep a prompt-injected agent away from the operator's OTHER
# secrets and from writing anywhere but where it is meant to: ~/.ssh, ~/.aws,
# ~/.config, other repositories, earlier agents' transcripts. It is NOT credential
# isolation from the agent itself: the CLI authenticates as the operator, so its
# own credential is inside with it, and the network is open because the CLI
# needs the API (docs/security.md, "What it does not close").
#
# THERE IS NO UNCONFINED PATH OUT: a missing sandbox tool, an unsupported OS or a
# bad argument is a non-zero exit before the agent starts.
#
# WHAT THE AGENT GETS
#   read          <dir>; the system (root read-only on Linux, everything outside
#                 $HOME on macOS) EXCEPT the hidden trees below; the toolchain
#                 directories under $HOME a CLI is installed in; FIXPOINT_SANDBOX_RO
#   hidden        $HOME, and like it every tree outside $HOME that a symlink in
#                 $HOME (depth 2) leads to, and FIXPOINT_SANDBOX_HIDE. <dir> and
#                 the exceptions above are bound back on top.
#   read+write    <dir> in rw mode only; a private scratch directory S (TMPDIR,
#                 removed on exit); FIXPOINT_SANDBOX_RW
#   CLI state     taken from the basename of argv[0]:
#     codex   a FRESH CODEX_HOME inside S. On a ChatGPT-login route the only thing
#             in it is a symlink to auth.json in $CODEX_HOME/.fixpoint-sandbox, a
#             copy of the login that every sandboxed codex shares and may rewrite;
#             a route with a model_provider of its own (an API key) gets no login
#             at all. The wrapper syncs the copy with the real auth.json, the newer
#             one winning and ONLY for the same account_id, before the agent starts
#             and when it exits -- a refresh token rotates, and a refresh lost
#             would log the operator out (THE SHARED CODEX LOGIN, below). The rest
#             of the real CODEX_HOME (sessions, history, config.toml) is not there.
#     claude  the REAL config directory, read-only, with its transcript and
#             session stores emptied (other projects' conversations are exactly
#             what must not be readable); .claude.json and .credentials.json stay
#             writable because the CLI rewrites them. .claude.json can declare
#             user-scope MCP servers, so a lens could plant one there that runs the
#             next time the operator starts claude: that cannot be closed while the
#             CLI needs to write the file.
#     other   no state at all. Bind what it needs with FIXPOINT_SANDBOX_RO/_RW.
#   GOCACHE is pointed into S: the real build cache is not writable in here.
#
# FIXPOINT_SANDBOX_RO, FIXPOINT_SANDBOX_RW and FIXPOINT_SANDBOX_HIDE are
# colon-separated lists of extra paths: to bind for a CLI or a toolchain this
# script does not know, or to hide. They come from the operator's environment
# (fixpoint passes them through to the wrapper) and never from a config file.
#
# PLATFORMS
#   Linux  bubblewrap: root read-only, /run masked (DNS's resolve directory bound
#          back), $HOME replaced by an empty tmpfs with only the toolchains, the
#          CLI state and <dir> bound back, /tmp replaced by S, own PID and IPC
#          namespaces and a session of its own, killed with the wrapper. Needs
#          unprivileged user namespaces (bwrap says so if it has none).
#   macOS  sandbox-exec: file CONTENTS under $HOME unreadable except what is
#          listed above (names stay visible -- metadata is not denied, which is
#          what keeps path resolution working), writes denied everywhere except S,
#          rw <dir> and the CLI state files, terminal ioctls denied. The hidden
#          trees outside $HOME the same as $HOME; the rest stays readable.
#   other  refused.
#
# SANDBOXES DO NOT NEST: codex's own --sandbox cannot start in here, which is why
# the shipped codex agents declare `when_sandboxed` and fixpoint swaps their flag
# when this wrapper is in use.
set -eu

nl='
'
me=fixpoint-sandbox

die() {
    echo "$me: $*" >&2
    exit 2
}

# THE SHARED CODEX LOGIN. codex (0.172 and later) saves a refreshed login by
# resolving the auth.json link, taking a commit lock beside the file it resolves to
# (auth.json.lock), writing a temp file in that directory and renaming it over the
# login. A link straight to the real ~/.codex/auth.json cannot work in here: the
# real directory is not writable (and must not be: config.toml there runs
# commands), and on Linux the file is a bind mount, which a rename cannot replace
# (EBUSY). The save fails, codex reports `workspace routing discovery unauthorized
# (401)`, and the refresh token the server has just rotated is lost.
#
# So every sandboxed codex shares ONE directory, $CODEX_HOME/.fixpoint-sandbox,
# writable inside, holding a copy of the login: each seat's link resolves there,
# its saves land there, and its commit lock is the same file for every seat and
# every concurrent run. The wrapper syncs that copy with the real auth.json, the
# newer last_refresh winning and only for the same account, under the commit lock
# codex itself takes on the real login: before the agent starts, and again when the
# wrapper exits. A wrapper killed outright (fixpoint ends a timed-out agent with a
# group SIGKILL) skips the second sync; the next start makes it.
#
# The shared directory is writable by the agent, so nothing is ever written
# THROUGH it: a copy out of it is read with head -c into a temp file in the real
# CODEX_HOME (which no agent can reach) and checked there, and a copy into it is a
# rename from such a temp file, which replaces a planted link instead of following
# it.
cx_acct() { sed -n 's/.*"account_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n 1; }
cx_when() { sed -n 's/.*"last_refresh"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n 1; }
# cx_older <a> <b>: is timestamp a strictly older than b? codex writes UTC
# RFC 3339, which sorts as text; a missing one is the oldest.
cx_older() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | LC_ALL=C sort | head -n 1)" = "$1" ]; }

# cx_sync <start|exit> <real auth.json> <shared copy> [<another candidate>]
# Run only under the lock (cx_locked). The candidates are the shared copy and, at
# exit, a login an older codex wrote over its own link in S. One that names
# another account is refused (and said so at exit, when a lens wrote it); of the
# rest the newest replaces the real login, a tie going to the sandbox side (it is
# what was refreshed). Then the shared copy is made to match the real login.
cx_sync() {
    when=$1 real=$2 shared=$3 extra=${4-}
    dir=${real%/*}
    if [ ! -f "$real" ]; then
        # Logged out (or never in): no copy of a login is kept for the sandbox.
        rm -rf "$shared"
        return 0
    fi
    want=$(cx_acct "$real")
    newest=$(cx_when "$real")
    best=
    for c in "$shared" "$extra"; do
        [ -n "$c" ] && [ -f "$c" ] && [ ! -L "$c" ] || continue
        tmp=$(mktemp "$dir/.fixpoint-sandbox-auth.XXXXXX") || return 1
        if ! head -c 65536 "$c" >"$tmp" 2>/dev/null || [ "$(wc -c <"$tmp" | tr -d ' ')" -ge 65536 ] ||
            cmp -s "$tmp" "$real"; then
            rm -f "$tmp"
            continue
        fi
        got=$(cx_acct "$tmp")
        if [ -z "$want" ] || [ "$got" != "$want" ]; then
            [ "$when" != exit ] || [ -z "$got" ] ||
                echo "$me: WARNING: codex wrote a login for a different account; NOT copied back to $real" >&2
            rm -f "$tmp"
            continue
        fi
        w=$(cx_when "$tmp")
        if cx_older "$w" "$newest"; then
            rm -f "$tmp"
            continue
        fi
        [ -z "$best" ] || rm -f "$best"
        best=$tmp newest=$w
    done
    if [ -n "$best" ]; then
        mv -f "$best" "$real" || {
            rm -f "$best"
            echo "$me: WARNING: could not copy the refreshed codex login back to $real" >&2
        }
    fi
    if [ ! -f "$shared" ] || [ -L "$shared" ] || ! cmp -s "$real" "$shared"; then
        tmp=$(mktemp "$dir/.fixpoint-sandbox-auth.XXXXXX") || return 1
        cp "$real" "$tmp" || {
            rm -f "$tmp"
            return 1
        }
        # A directory planted in its place would take the file INTO it.
        if [ -d "$shared" ] && [ ! -L "$shared" ]; then rm -rf "$shared"; fi
        mv -f "$tmp" "$shared" || {
            rm -f "$tmp"
            return 1
        }
    fi
    return 0
}

# cx_locked <cx_sync args...>: cx_sync under codex's own commit lock on the real
# login, so it is serialized with a codex running outside the sandbox (flock(2),
# which both flock(1) and macOS's lockf(1) take).
cx_locked() {
    lock=${2%/*}/auth.json.lock
    if command -v flock >/dev/null 2>&1; then
        (umask 077 && flock -w 10 "$lock" /bin/sh "$0" --codex-sync "$@")
    elif command -v lockf >/dev/null 2>&1; then
        (umask 077 && lockf -k -t 10 "$lock" /bin/sh "$0" --codex-sync "$@")
    else
        echo "$me: WARNING: neither flock nor lockf found; syncing the codex login unlocked" >&2
        (umask 077 && cx_sync "$@")
    fi
}

if [ "${1-}" = --codex-sync ]; then
    shift
    umask 077
    cx_sync "$@"
    exit
fi

usage="usage: $me <dir> <ro|rw> -- <agent argv...>"
[ $# -ge 4 ] || die "$usage"
target=$1
mode=$2
shift 2
[ "$1" = -- ] || die "$usage"
shift
[ $# -ge 1 ] || die "no agent command after --"
case $mode in
ro | rw) ;;
*) die "mode '$mode' is not ro or rw" ;;
esac

# The macOS profile is text: a quote, a backslash or a newline in a path would
# change what it says, so such a path is refused rather than escaped. Linux gets
# the same rule so the two platforms accept the same layouts.
plain() {
    case $1 in
    *\"* | *\\* | *"$nl"*) die "path '$1' contains a quote, a backslash or a newline" ;;
    esac
}

# phys <dir> prints the physical path of an existing directory, or nothing.
phys() { (cd "$1" 2>/dev/null && pwd -P) || true; }

# physany <path> is phys for a file or a directory.
physany() {
    if [ -d "$1" ]; then
        phys "$1"
    elif [ -e "$1" ]; then
        d=$(phys "$(dirname "$1")")
        [ -n "$d" ] && printf '%s/%s\n' "$d" "$(basename "$1")"
    fi
}

# inside <path> <dir>: is path dir itself or below it?
inside() {
    case "$1/" in
    "$2"/*) return 0 ;;
    esac
    return 1
}

[ -d "$target" ] || die "'$target' is not a directory"
target=$(phys "$target")
[ -n "$target" ] || die "cannot resolve the directory"
[ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "HOME is not set to a directory"
home=$(phys "$HOME")
[ -n "$home" ] || die "cannot resolve HOME"
plain "$target"
plain "$home"
# Handing the agent the home directory, or a directory holding it, is handing it
# everything this script exists to hide.
[ "$target" != / ] || die "refusing to confine an agent to /"
inside "$home" "$target" && die "'$target' is or contains your home directory, which is what this wrapper hides; review a project directory instead"

codexdir=${CODEX_HOME:-$home/.codex}
[ ! -e "$codexdir" ] || codexdir=$(phys "$codexdir")
[ -n "$codexdir" ] || die "CODEX_HOME exists but is not a directory I can resolve"
claudedir=${CLAUDE_CONFIG_DIR:-$home/.claude}
[ ! -e "$claudedir" ] || claudedir=$(phys "$claudedir")
[ -n "$claudedir" ] || die "the claude config dir exists but is not a directory I can resolve"
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    claudejson=$claudedir/.claude.json
else
    claudejson=$home/.claude.json
fi
for p in "$codexdir" "$claudedir" "$claudejson"; do plain "$p"; done
for state in "$codexdir" "$claudedir"; do
    inside "$state" "$target" && die "'$target' contains the CLI state directory '$state'; review a directory that does not"
done

# The operator's extra paths. Each must exist; a writable one may not be or hold
# $HOME, and none may be the target's ancestor in rw (that would make the whole
# target's parent writable).
extra_ro=
extra_rw=
addextra() { # addextra <var> <ro|rw>
    eval "list=\${$1:-}"
    oldifs=$IFS
    IFS=:
    set -f
    for p in $list; do
        [ -n "$p" ] || continue
        [ -e "$p" ] || die "$1: '$p' does not exist"
        r=$(physany "$p")
        [ -n "$r" ] || die "$1: cannot resolve '$p'"
        plain "$r"
        inside "$home" "$r" && die "$1: '$r' is or contains your home directory"
        if [ "$2" = rw ]; then
            inside "$target" "$r" && [ "$r" != "$target" ] && die "$1: '$r' contains the reviewed directory; make the directory itself writable with can_edit, not its parent"
            extra_rw="$extra_rw$nl$r"
        else
            extra_ro="$extra_ro$nl$r"
        fi
    done
    set +f
    IFS=$oldifs
}
addextra FIXPOINT_SANDBOX_RO ro
addextra FIXPOINT_SANDBOX_RW rw

# A git worktree's .git is a file naming the real git directory, usually outside
# the target; without it every git command the agent runs fails. Bound read-only.
gitdirs=
if [ -f "$target/.git" ]; then
    gd=$(sed -n 's/^gitdir: //p' "$target/.git" | head -n 1)
    case $gd in
    /*) ;;
    ?*) gd=$target/$gd ;;
    esac
    if [ -n "$gd" ] && [ -d "$gd" ]; then
        gd=$(phys "$gd")
        common=$gd
        if [ -f "$gd/commondir" ]; then
            c=$(head -n 1 "$gd/commondir")
            case $c in
            /*) ;;
            *) c=$gd/$c ;;
            esac
            [ ! -d "$c" ] || common=$(phys "$c")
        fi
        for g in "$gd" "$common"; do
            plain "$g"
            inside "$home" "$g" && die "the worktree's git directory '$g' is or contains your home directory"
            gitdirs="$gitdirs$nl$g"
        done
    fi
fi

# Which CLI, from argv[0]. An unknown binary is given no state at all.
cli=${1##*/}
case $cli in
codex | claude) ;;
*) cli=other ;;
esac
agent_path=$(command -v "$1" 2>/dev/null) || agent_path=
agent_real=
if [ -n "$agent_path" ]; then
    agent_real=$(physany "$agent_path")
    # A symlink to the real install (npm's bin links do this).
    if [ -L "$agent_path" ] && command -v readlink >/dev/null 2>&1; then
        l=$(readlink -f "$agent_path" 2>/dev/null) || l=
        [ -z "$l" ] || agent_real=$l
    fi
fi

# A codex route that carries a model_provider of its own authenticates with that
# provider's key and needs no ChatGPT login, so it is given none: an ollama or
# OpenRouter model has no business holding the operator's OpenAI token.
codex_auth=0
if [ "$cli" = codex ]; then
    codex_auth=1
    for a in "$@"; do
        case $a in
        model_provider=* | *.model_provider=*) codex_auth=0 ;;
        esac
    done
    [ -f "$codexdir/auth.json" ] || codex_auth=0
fi

# The shared copy of the login every sandboxed codex uses (THE SHARED CODEX LOGIN,
# above), brought up to date before the agent starts. A refresh a killed wrapper
# left in it reaches the real auth.json here.
cxshared=$codexdir/.fixpoint-sandbox
if [ "$codex_auth" = 1 ]; then
    if [ -L "$cxshared" ] || { [ -e "$cxshared" ] && [ ! -d "$cxshared" ]; }; then
        die "'$cxshared' is not a directory; remove it"
    fi
    (umask 077 && mkdir -p "$cxshared") || die "cannot create '$cxshared' for the codex login"
    chmod 700 "$cxshared"
    cx_locked start "$codexdir/auth.json" "$cxshared/auth.json" ||
        die "cannot bring the codex login in '$cxshared' up to date"
    [ -f "$cxshared/auth.json" ] || die "no codex login in '$cxshared' after syncing it"
    # Temp files of a codex killed mid-save.
    find "$cxshared" -maxdepth 1 -type f -name '.auth-*' -mmin +60 -exec rm -f {} + 2>/dev/null || true
fi

os=$(uname -s)
case $os in
Darwin) command -v sandbox-exec >/dev/null 2>&1 || die "sandbox-exec not found; refusing to run the agent unconfined" ;;
Linux) command -v bwrap >/dev/null 2>&1 || die "bwrap (bubblewrap) not found; install it, or run fixpoint with -sandbox off. Refusing to run the agent unconfined" ;;
*) die "unsupported OS '$os'; refusing to run the agent unconfined" ;;
esac

# The per-invocation scratch directory S.
tb=$(phys "${TMPDIR:-/tmp}")
[ -n "$tb" ] || die "TMPDIR '${TMPDIR:-/tmp}' is not a directory"
inside "$tb" "$target" && die "TMPDIR '$tb' is the reviewed directory or inside it; the scratch directory must not be part of what is reviewed"
inside "$tb" "$home" && [ "$os" = Linux ] && die "TMPDIR '$tb' is inside your home directory, which this wrapper hides; point TMPDIR elsewhere"
S=$(mktemp -d "$tb/fixpoint-sandbox.XXXXXX") || die "cannot create a scratch directory in '$tb'"

# Copy a refreshed codex login back. Runs on every exit, outside the sandbox.
codex_writeback() {
    [ "$codex_auth" = 1 ] || return 0
    [ -d "$cxshared" ] && [ ! -L "$cxshared" ] || return 0
    cx_locked exit "$codexdir/auth.json" "$cxshared/auth.json" "$S/codex/auth.json" ||
        echo "$me: WARNING: could not sync the codex login in $cxshared back to $codexdir/auth.json" >&2
}

# A CLI can leave a descendant still writing into S when the agent itself has
# exited: a few tries, a second apart, so the directory is not left behind.
cleanup() {
    codex_writeback || true
    n=0
    while [ -e "$S" ] && [ "$n" -lt 5 ]; do
        rm -rf "$S" 2>/dev/null || true
        [ ! -e "$S" ] || sleep 1
        n=$((n + 1))
    done
}
trap cleanup EXIT
resolved=$(phys "$S")
[ -n "$resolved" ] || die "cannot resolve the scratch directory"
S=$resolved
plain "$S"
chmod 700 "$S"

child=
on_signal() {
    [ -z "$child" ] || kill -TERM "$child" 2>/dev/null || true
}
# A signal the wrapper was sent must not be forgotten when the agent, having
# received it, exits 0: the run was interrupted and the exit status says so.
got_signal=0
trap 'got_signal=143; on_signal' TERM
trap 'got_signal=130; on_signal' INT
trap 'got_signal=129; on_signal' HUP

# Where S is, from inside. On Linux it IS the sandbox's /tmp.
case $os in
Linux) inner=/tmp ;;
*) inner=$S ;;
esac

TMPDIR=$inner
GOCACHE=$inner/go-build
export TMPDIR GOCACHE
case $cli in
claude)
    # The claude CLI's shell tool otherwise makes /tmp/claude-<uid>/<cwd slug>,
    # shared by every lens on this directory.
    CLAUDE_CODE_TMPDIR=$inner
    export CLAUDE_CODE_TMPDIR
    ;;
codex)
    mkdir "$S/codex"
    if [ "$codex_auth" = 1 ]; then
        # A link to the shared copy: codex resolves it, so its saves and its commit
        # lock land there, the same for every seat.
        ln -s "$cxshared/auth.json" "$S/codex/auth.json"
    fi
    CODEX_HOME=$inner/codex
    export CODEX_HOME
    ;;
esac

# The claude config directory's session and transcript state: other projects'
# conversations. history.jsonl is a file and is handled beside these.
claude_unreadable="projects sessions session-env shell-snapshots todos file-history backups debug plans paste-cache tasks teams usage-data image-cache"

# Toolchain directories under $HOME a CLI or its interpreter is installed in,
# bound back read-only. Whole ~/.local is NOT among them: ~/.local/share holds
# keyrings and other applications' data.
toolchains=
for d in .nvm .npm-global .volta .fnm .asdf .bun .cargo .rustup .deno .pyenv .local/bin .local/lib go/pkg/mod; do
    [ -d "$home/$d" ] && toolchains="$toolchains$nl$home/$d"
done
# The directory the agent binary really lives in, when that is under $HOME: its
# top-level directory there, or for ~/.local/share/<app> that app's directory.
case $agent_real in
"$home"/.local/share/*)
    rest=${agent_real#"$home"/.local/share/}
    toolchains="$toolchains$nl$home/.local/share/${rest%%/*}"
    ;;
"$home"/.local/*) ;;
"$home"/*)
    rest=${agent_real#"$home"/}
    toolchains="$toolchains$nl$home/${rest%%/*}"
    ;;
esac
oldifs=$IFS
IFS=$nl
for d in $toolchains; do [ -z "$d" ] || plain "$d"; done
IFS=$oldifs

# Trees OUTSIDE $HOME that are the operator's as much as $HOME is. Hiding $HOME
# alone left them readable through the root: `~/oddin -> /tank/enc/oddin` put
# every other repository in reach of an agent reviewing one of them. Hidden the
# same way $HOME is (an empty tmpfs on Linux, file contents unreadable on macOS),
# with the same exceptions bound back on top: <dir>, the toolchains, the agent's
# install directory, the CLI state, the extra paths, a worktree's git directory.
#
#   derived   the target of every symlink in $HOME down to depth 2 that leads out
#             of it. Not hidden: a target inside $HOME (already hidden), inside
#             <dir> or <dir> itself (what is under review), under a system root
#             (/usr, /etc, /opt, /var/lib, ...; nothing of the operator's, and
#             hiding it would break the agent: ~/bin/x -> /opt/x/bin/x is common),
#             or holding TMPDIR (S would be hidden with it). /var and /private as
#             a whole are NOT system roots: /var/www is somebody's data, and on
#             macOS every temporary directory is under /private/var.
#   FIXPOINT_SANDBOX_HIDE  colon-separated, from the operator's environment and
#             never from a config: what no symlink leads to. Each entry must exist
#             and must not hold <dir>; a bad entry stops the agent before it
#             starts. An entry INSIDE <dir> is hidden on top of it.
system_root() {
    [ "$1" = / ] && return 0
    case "$1/" in
    /usr/* | /bin/* | /sbin/* | /lib/* | /lib32/* | /lib64/* | /libx32/* | /etc/* | /opt/* | /nix/* | /snap/* | /proc/* | /sys/* | /dev/* | /run/* | /boot/* | /tmp/* | /var/lib/* | /var/cache/* | /var/run/* | /var/tmp/* | /System/* | /Library/* | /Applications/* | /private/etc/* | /private/var/run/* | /private/var/db/* | /private/tmp/*) return 0 ;;
    esac
    return 1
}
# resolve <path>: the physical path a symlink leads to, or nothing.
resolve() {
    if [ -d "$1" ]; then
        phys "$1"
    elif [ -e "$1" ]; then
        readlink -f "$1" 2>/dev/null || true
    fi
}
hidden=       # hidden before <dir> is bound, so <dir> stays visible inside them
hidden_late=  # FIXPOINT_SANDBOX_HIDE entries inside <dir>, hidden on top of it
addhidden() { # addhidden <path>, already physical and plain
    case "$nl$hidden$nl" in
    *"$nl$1$nl"*) return 0 ;;
    esac
    hidden="$hidden$nl$1"
}
links=$(find "$home" -mindepth 1 -maxdepth 2 -type l 2>/dev/null) || links=
oldifs=$IFS
IFS=$nl
for l in $links; do
    [ -L "$l" ] || continue
    r=$(resolve "$l")
    [ -n "$r" ] || continue # dangling
    inside "$r" "$home" && continue
    inside "$r" "$target" && continue
    system_root "$r" && continue
    inside "$tb" "$r" && continue
    case $r in
    *\"* | *\\*) die "the symlink '$l' leads to '$r', which contains a quote or a backslash; this wrapper cannot hide it, so it refuses to run" ;;
    esac
    addhidden "$r"
done
IFS=$oldifs
list=${FIXPOINT_SANDBOX_HIDE:-}
oldifs=$IFS
IFS=:
set -f
for p in $list; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || die "FIXPOINT_SANDBOX_HIDE: '$p' does not exist"
    r=$(physany "$p")
    [ -n "$r" ] || die "FIXPOINT_SANDBOX_HIDE: cannot resolve '$p'"
    plain "$r"
    inside "$target" "$r" && die "FIXPOINT_SANDBOX_HIDE: '$r' is or contains the reviewed directory '$target'"
    inside "$tb" "$r" && die "FIXPOINT_SANDBOX_HIDE: '$r' is or contains TMPDIR '$tb', where the agent's scratch directory lives"
    if inside "$r" "$target"; then
        hidden_late="$hidden_late$nl$r"
    else
        addhidden "$r"
    fi
done
set +f
IFS=$oldifs
# What lives inside a hidden tree and must be bound back read-only: a toolchain
# whose real directory is in one (~/.cargo -> /data/cargo), and the agent's own
# install directory -- the top-level directory under the hidden one holding it.
backs=
oldifs=$IFS
IFS=$nl
for h in $hidden; do
    [ -n "$h" ] || continue
    for d in $toolchains; do
        [ -n "$d" ] || continue
        p=$(phys "$d")
        [ -n "$p" ] && inside "$p" "$h" && backs="$backs$nl$p"
    done
    if [ -n "$agent_real" ] && inside "$agent_real" "$h"; then
        rest=${agent_real#"$h"/}
        backs="$backs$nl$h/${rest%%/*}"
    fi
done
for d in $backs; do [ -z "$d" ] || plain "$d"; done
IFS=$oldifs

case $os in
Darwin)
    # SBPL is last-match-wins, so the order is load-bearing: denies, then what is
    # allowed back from them, then the denies that nothing may override. And a rule
    # naming file-read* does NOT override one naming file-read-data, in either
    # direction (measured on macOS 26: after a file-read-data deny on $HOME, an
    # exact-path file-read* allow still left the file unreadable). So every read
    # rule below is written for BOTH operations, through rr; only the $HOME deny is
    # file-read-data alone, which leaves names and metadata visible.
    rr() { verb=$1; shift; prof="$prof$nl($verb file-read* $*)$nl($verb file-read-data $*)"; }
    rd() { rr allow "(subpath \"$1\")"; }
    prof="(version 1)
(allow default)
(deny file-read-data (subpath \"$home\"))"
    # The trees outside $HOME, exactly as $HOME: contents unreadable, names
    # visible, and everything allowed back below wins over them.
    oldifs=$IFS
    IFS=$nl
    for h in $hidden; do
        [ -n "$h" ] && prof="$prof$nl(deny file-read-data (subpath \"$h\"))"
    done
    IFS=$oldifs
    rr deny "(prefix \"$tb/fixpoint-sandbox.\")"
    rd "$S"
    rd "$target"
    oldifs=$IFS
    IFS=$nl
    for d in $hidden_late; do
        [ -n "$d" ] && rr deny "(subpath \"$d\")"
    done
    for d in $backs; do
        [ -n "$d" ] && rd "$d"
    done
    IFS=$oldifs
    oldifs=$IFS
    IFS=$nl
    for d in $toolchains $extra_ro $extra_rw $gitdirs; do
        [ -n "$d" ] && rd "$d"
    done
    IFS=$oldifs
    # The keychain: claude's login lives there. Its items stay behind securityd's
    # own access control; what is readable here is the encrypted database.
    [ ! -d "$home/Library/Keychains" ] || rd "$home/Library/Keychains"
    case $cli in
    codex)
        rr deny "(subpath \"$codexdir\") (subpath \"$claudedir\") (literal \"$claudejson\")"
        [ "$codex_auth" = 0 ] || rr allow "(subpath \"$cxshared\")"
        ;;
    claude)
        rr allow "(subpath \"$claudedir\") (prefix \"$claudejson\")"
        rr deny "(subpath \"$codexdir\")"
        for d in $claude_unreadable history.jsonl; do
            rr deny "(subpath \"$claudedir/$d\")"
        done
        ;;
    *)
        rr deny "(subpath \"$codexdir\") (subpath \"$claudedir\") (literal \"$claudejson\")"
        ;;
    esac
    # The operator's terminal: TIOCSTI on it types into the operator's shell,
    # outside this profile.
    prof="$prof
(deny file-ioctl (regex #\"^/dev/(tty|pty|console)\"))
(deny file-write*)
(allow file-write* (literal \"/dev/null\") (literal \"/dev/dtracehelper\") (subpath \"$S\"))"
    case $cli in
    codex)
        [ "$codex_auth" = 0 ] || prof="$prof
(allow file-write* (prefix \"$cxshared/\"))"
        ;;
    claude)
        prof="$prof
(allow file-write* (prefix \"$claudejson\"))"
        ;;
    esac
    oldifs=$IFS
    IFS=$nl
    for d in $extra_rw; do
        [ -n "$d" ] && prof="$prof
(allow file-write* (subpath \"$d\"))"
    done
    IFS=$oldifs
    if [ "$mode" = rw ]; then
        prof="$prof
(allow file-write* (subpath \"$target\"))"
    else
        prof="$prof
(deny file-write* (subpath \"$target\"))"
    fi
    set -- sandbox-exec -p "$prof" "$@"
    ;;
Linux)
    # POSIX sh has no arrays, so the bwrap arguments are appended after the
    # agent's argv in "$@" and the agent's argv is rotated behind them at the end.
    # Later mounts sit on top of earlier ones.
    argc=$#
    # /run: the user D-Bus socket lets a process start anything as the operator
    # OUTSIDE this sandbox, and /run/docker.sock is root. DNS needs the directory
    # systemd-resolved's /etc/resolv.conf points into.
    set -- "$@" --tmpfs /run
    [ ! -d /run/systemd/resolve ] || set -- "$@" --ro-bind /run/systemd/resolve /run/systemd/resolve
    # /tmp is S. Replaced FIRST, so everything bound below -- $HOME's state, the
    # extra paths, the reviewed directory -- stays visible even where it lives under
    # /tmp or $TMPDIR. A TMPDIR other than /tmp holds the other invocations' scratch
    # directories beside this one's, so it is masked.
    case $tb in
    /tmp | /) ;;
    *) set -- "$@" --tmpfs "$tb" ;;
    esac
    set -- "$@" --bind "$S" /tmp
    # The trees outside $HOME, before $HOME's own tmpfs: one of them may hold
    # $HOME, and everything bound back below sits on top of them.
    oldifs=$IFS
    IFS=$nl
    for h in $hidden; do
        [ -n "$h" ] || continue
        if [ -d "$h" ]; then
            set -- "$@" --tmpfs "$h"
        else
            set -- "$@" --ro-bind /dev/null "$h"
        fi
    done
    IFS=$oldifs
    set -- "$@" --tmpfs "$home"
    # CLI state relocated OUTSIDE $HOME is not hidden by the tmpfs above.
    for state in "$codexdir" "$claudedir"; do
        if [ -d "$state" ] && ! inside "$state" "$home"; then
            set -- "$@" --tmpfs "$state"
        fi
    done
    oldifs=$IFS
    IFS=$nl
    for d in $toolchains $backs; do
        [ -n "$d" ] && [ -e "$d" ] && set -- "$@" --ro-bind "$d" "$d"
    done
    IFS=$oldifs
    case $cli in
    codex)
        [ "$codex_auth" = 0 ] || set -- "$@" --bind "$cxshared" "$cxshared"
        ;;
    claude)
        if [ -d "$claudedir" ]; then
            # The transcript directories are created in the real directory if
            # missing, because a mount point has to exist; each is then an empty
            # tmpfs: writable for the session, never persisted.
            set -- "$@" --ro-bind "$claudedir" "$claudedir"
            for d in $claude_unreadable telemetry cache; do
                mkdir -p "$claudedir/$d"
                set -- "$@" --tmpfs "$claudedir/$d"
            done
            [ ! -f "$claudedir/history.jsonl" ] || set -- "$@" --ro-bind /dev/null "$claudedir/history.jsonl"
            [ ! -f "$claudedir/.credentials.json" ] || set -- "$@" --bind "$claudedir/.credentials.json" "$claudedir/.credentials.json"
        fi
        [ ! -f "$claudejson" ] || set -- "$@" --bind "$claudejson" "$claudejson"
        ;;
    esac
    # The operator's extra paths and a worktree's git directory.
    oldifs=$IFS
    IFS=$nl
    for d in $extra_ro $gitdirs; do
        [ -n "$d" ] && set -- "$@" --ro-bind "$d" "$d"
    done
    for d in $extra_rw; do
        [ -n "$d" ] && set -- "$@" --bind "$d" "$d"
    done
    IFS=$oldifs
    # Last of the mounts, so nothing above (a tmpfs on /tmp or on $HOME) hides it.
    if [ "$mode" = rw ]; then
        set -- "$@" --bind "$target" "$target"
    else
        set -- "$@" --ro-bind "$target" "$target"
    fi
    # The operator's hide entries inside <dir>: after it, or it would cover them.
    oldifs=$IFS
    IFS=$nl
    for h in $hidden_late; do
        [ -n "$h" ] || continue
        if [ -d "$h" ]; then
            set -- "$@" --tmpfs "$h"
        else
            set -- "$@" --ro-bind /dev/null "$h"
        fi
    done
    IFS=$oldifs
    n=0
    while [ "$n" -lt "$argc" ]; do
        a=$1
        shift
        set -- "$@" "$a"
        n=$((n + 1))
    done
    # A fresh /dev and /proc in a new PID namespace (or /proc/<fixpoint's pid>
    # would reach outside); --die-with-parent ties the agent to this wrapper;
    # --new-session keeps it off the operator's terminal (TIOCSTI).
    set -- bwrap --die-with-parent --new-session --unshare-pid --unshare-ipc \
        --ro-bind / / --dev /dev --proc /proc --chdir "$target" "$@"
    ;;
esac

# The agent is a child, so S can be cleaned up afterwards. Its stdin is the
# wrapper's: the agents read their prompt from stdin.
exec 3<&0
"$@" <&3 3<&- &
child=$!
exec 3<&-
rc=0
while :; do
    wait "$child" && rc=0 || rc=$?
    kill -0 "$child" 2>/dev/null || break
done
if [ "$got_signal" != 0 ] && [ "$rc" = 0 ]; then
    rc=$got_signal
fi
exit "$rc"
